--- /dev/null
+++ b/drivers/misc/hma_uidfake/netlink.c
@@ -0,0 +1,323 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * netlink.c - the channel from privileged userspace into the kernel: the policy,
+ * the caller apk table and a status reply. The wire format is include/kaux.h,
+ * which the tool includes as well, so the two ends cannot drift apart.
+ */
+
+#include "uidfake.h"
+#include <linux/kernel.h>
+#include <linux/mutex.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/version.h> /* LINUX_VERSION_CODE for the resv_start_op guard */
+#include <linux/crc32.h>
+#include <linux/string.h>
+#include <linux/vmalloc.h>
+#include <linux/cred.h>
+#include <net/net_namespace.h>
+#include <net/genetlink.h>
+
+#include "kaux.h"
+
+#define MAX_BLOB_BYTES 32768
+
+/* A policy larger than one message arrives in pages and is held here until its
+ * last page and its CRC have been seen: the live policy is replaced in one step,
+ * or not at all. */
+static DEFINE_MUTEX(g_staged_lock);
+/* The apply runs on the one buffer both ends share, so a second commit cannot
+ * start until the first has finished reading it: two uploads at once (two
+ * helpers, or a retry that overlapped) used to copy into that buffer while it
+ * was being parsed. The staging lock is not the one to hold for this -- it must
+ * be dropped before the apply, or an install hangs on the next page. */
+static DEFINE_MUTEX(g_apply_lock);
+static u32 *g_staged;
+/* The blob being applied, while the staging buffer is free for the next upload. */
+static u32 *g_apply;
+static u32 g_staged_kind;
+static u32 g_staged_total; /* bytes */
+static u32 g_staged_len; /* bytes written so far */
+static u32 g_staged_crc;
+static u32 g_staged_owner;
+static bool g_staged_active;
+
+/* How big a staged blob may be (KAUX_KIND_* and its layout are in kaux.h). */
+/* What the two ends actually send: a policy is at most POLICY_MAX_PAIRS pairs of two
+ * u32 (512 KiB) and an apk set at most 10000 entries of 16 bytes plus their paths
+ * (~800 KiB), so 2 MiB is twice what fits and 4 MiB was four times it -- a wasted six
+ * megabytes of kernel memory on a phone, allocated on the first upload and held until
+ * the module goes away. */
+#define KAUX_STAGED_BYTES (2u * 1024u * 1024u)
+
+/* The helper gets the same value from zlib: crc32_le(~0, ..) ^ ~0 is zlib's
+ * crc32(0, ..). Both are byte-wise, so the endianness of either side is not part
+ * of the agreement. */
+static u32 kaux_crc32(const u8 *data, size_t bytes)
+{
+	return crc32_le(~0u, data, bytes) ^ ~0u;
+}
+
+/*
+ * The command ids moved when the staged upload was added, and a helper of the
+ * other version would read a ping as a set: the family version is checked, not
+ * assumed.
+ */
+/* Defined with its ops below; the status reply names it. */
+static struct genl_family kaux_family;
+
+static int kaux_version(struct genl_info *info)
+{
+	if (!uid_eq(current_euid(), GLOBAL_ROOT_UID) ||
+	    !net_eq(genl_info_net(info), &init_net))
+		return -EPERM;
+	return info->genlhdr->version == KAUX_FAMILY_VERSION ? 0 :
+							       -EPROTONOSUPPORT;
+}
+
+static int kaux_blob(struct genl_info *info, const u32 **p, u32 *len)
+{
+	if (kaux_version(info))
+		return -EPROTONOSUPPORT;
+	if (!info->attrs[KAUX_ATTR_BLOB])
+		return -EINVAL;
+	*p = nla_data(info->attrs[KAUX_ATTR_BLOB]);
+	*len = nla_len(info->attrs[KAUX_ATTR_BLOB]);
+	if (*len < 4 || (*len & 3) || *len > MAX_BLOB_BYTES)
+		return -EINVAL;
+	return 0;
+}
+
+/* blob: u32 total_pairs, u32 total_words, u32 crc32 */
+static int kaux_set_begin(struct sk_buff *skb, struct genl_info *info)
+{
+	const struct kaux_begin *b;
+	const u32 *p;
+	u32 len;
+	int rc = 0;
+
+	mutex_lock(&g_staged_lock);
+
+	/*
+	 * The staging buffer is allocated on the first upload, not at load: it is
+	 * megabytes now, and the module is loaded while /data is barely there.
+	 */
+	if (g_staged == NULL)
+		g_staged = kvzalloc(KAUX_STAGED_BYTES, GFP_KERNEL);
+	if (g_staged == NULL) {
+		rc = -ENOMEM;
+		goto out;
+	}
+
+	if (kaux_blob(info, &p, &len) || len < sizeof(*b)) {
+		rc = -EINVAL;
+		goto out;
+	}
+	b = (const struct kaux_begin *)p;
+	if (b->kind > KAUX_KIND_MAX || b->bytes > KAUX_STAGED_BYTES ||
+	    (b->kind == KAUX_KIND_POLICY &&
+	     (b->bytes % 8u || b->bytes / 8u > POLICY_MAX_PAIRS)) ||
+	    (b->kind == KAUX_KIND_APKS && b->bytes < 4)) {
+		rc = -EINVAL;
+		goto out;
+	}
+
+	g_staged_kind = b->kind;
+	g_staged_total = b->bytes;
+	g_staged_len = 0;
+	g_staged_crc = b->crc32;
+	g_staged_owner = info->snd_portid;
+	g_staged_active = true;
+
+out:
+	mutex_unlock(&g_staged_lock);
+	return rc;
+}
+
+/* blob: u32 seq, u32 npairs, then npairs * (caller, target) */
+static int kaux_set_page(struct sk_buff *skb, struct genl_info *info)
+{
+	const u32 *p;
+	u32 len, offset, bytes;
+	int rc = 0;
+
+	mutex_lock(&g_staged_lock);
+
+	if (kaux_blob(info, &p, &len) || len < 8) {
+		rc = -EINVAL;
+		goto out;
+	}
+	offset = p[0];
+	bytes = p[1];
+	if (len < 8 || bytes > len - 8) {
+		rc = -EINVAL;
+		goto out;
+	}
+	if (!g_staged_active || g_staged_owner != info->snd_portid ||
+	    offset != g_staged_len ||
+	    bytes > g_staged_total - g_staged_len) {
+		rc = -EINVAL;
+		goto out;
+	}
+
+	memcpy((u8 *)g_staged + offset, p + 2, bytes);
+	g_staged_len += bytes;
+
+out:
+	mutex_unlock(&g_staged_lock);
+	return rc;
+}
+
+static int kaux_set_commit(struct sk_buff *skb, struct genl_info *info)
+{
+	u32 kind = 0, bytes = 0;
+	int rc = 0;
+
+	if (kaux_version(info))
+		return -EPROTONOSUPPORT;
+
+	mutex_lock(&g_apply_lock);
+	mutex_lock(&g_staged_lock);
+	if (!g_staged_active || g_staged_owner != info->snd_portid ||
+	    g_staged_len != g_staged_total) {
+		rc = -EINVAL;
+		goto out;
+	}
+	if (kaux_crc32((const u8 *)g_staged, g_staged_len) != g_staged_crc) {
+		pr_err("uidfake: staged blob crc mismatch, nothing applied\n");
+		rc = -EINVAL;
+		goto out;
+	}
+	/*
+	 * The blob is moved out of the staging buffer and applied with the lock
+	 * dropped. Applying it resolves paths and touches inodes, and that can
+	 * sleep: an apply inside this lock blocks the next page of the next upload,
+	 * which is what turned an install into a hang.
+	 */
+	if (g_apply == NULL)
+		g_apply = kvzalloc(KAUX_STAGED_BYTES, GFP_KERNEL);
+	if (g_apply == NULL) {
+		rc = -ENOMEM;
+		goto out;
+	}
+	kind = g_staged_kind;
+	bytes = g_staged_total;
+	memcpy(g_apply, g_staged, bytes);
+	g_staged_total = 0;
+	g_staged_len = 0;
+	g_staged_active = false;
+
+out:
+	mutex_unlock(&g_staged_lock);
+	if (rc == 0) {
+		if (kind == KAUX_KIND_POLICY) {
+			pr_info("uidfake: netlink policy: %u pair(s) in pages\n",
+				bytes / 8u);
+			if (bytes % 8u || bytes / 8u > POLICY_MAX_PAIRS)
+				rc = -EINVAL;
+			else
+				rc = policy_apply(g_apply, bytes / 8u);
+		} else {
+			pr_info("uidfake: netlink apks: %u byte(s) in pages\n",
+				bytes);
+			rc = uidfake_apk_apply(g_apply, bytes);
+		}
+	}
+	mutex_unlock(&g_apply_lock);
+	return rc;
+}
+
+static int kaux_ping(struct sk_buff *skb, struct genl_info *info)
+{
+	if (kaux_version(info))
+		return -EPROTONOSUPPORT;
+
+	/* A command id that lands here instead of where it belongs would otherwise
+   * look like a success, because a ping is answered with an ACK like anything
+   * else. */
+	pr_info("uidfake: netlink ping\n");
+	return 0;
+}
+
+/*
+ * How the module is doing, as one fixed structure (kaux.h): what it hooked, and
+ * what it failed to. This is the only command that answers with data, and the
+ * only one a user ends up seeing -- the tool puts it in the module's description
+ * line, which is where KernelSU and Magisk show a module's state.
+ */
+static int kaux_status(struct sk_buff *skb, struct genl_info *info)
+{
+	struct kaux_status st;
+	struct sk_buff *out;
+	void *hdr;
+
+	if (kaux_version(info))
+		return -EPROTONOSUPPORT;
+
+	uidfake_status_get(&st);
+
+	out = genlmsg_new(NLMSG_GOODSIZE, GFP_KERNEL);
+	if (!out)
+		return -ENOMEM;
+	hdr = genlmsg_put_reply(out, info, &kaux_family, 0, KAUX_CMD_STATUS);
+	if (hdr == NULL || nla_put(out, KAUX_ATTR_STATUS, sizeof(st), &st)) {
+		nlmsg_free(out);
+		return -EMSGSIZE;
+	}
+	genlmsg_end(out, hdr);
+	return genlmsg_reply(out, info);
+}
+
+static const struct genl_ops kaux_ops[] = {
+	{ .cmd = KAUX_CMD_PING, .flags = GENL_ADMIN_PERM, .doit = kaux_ping },
+	{ .cmd = KAUX_CMD_STATUS,
+	  .flags = GENL_ADMIN_PERM,
+	  .doit = kaux_status },
+	{ .cmd = KAUX_CMD_STAGE_BEGIN,
+	  .flags = GENL_ADMIN_PERM,
+	  .doit = kaux_set_begin },
+	{ .cmd = KAUX_CMD_STAGE_CHUNK,
+	  .flags = GENL_ADMIN_PERM,
+	  .doit = kaux_set_page },
+	{ .cmd = KAUX_CMD_STAGE_COMMIT,
+	  .flags = GENL_ADMIN_PERM,
+	  .doit = kaux_set_commit },
+};
+
+static const struct genl_multicast_group kaux_mcgrps[] = {
+	{ .name = "events" }
+};
+
+static struct genl_family kaux_family = {
+	.name = KAUX_FAMILY_NAME,
+	.version = KAUX_FAMILY_VERSION,
+	.maxattr = KAUX_ATTR_MAX,
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
+	.resv_start_op = KAUX_CMD_MAX + 1,
+#endif
+	.module = THIS_MODULE,
+	.ops = kaux_ops,
+	.n_ops = ARRAY_SIZE(kaux_ops),
+	.mcgrps = kaux_mcgrps,
+	.n_mcgrps = ARRAY_SIZE(kaux_mcgrps),
+};
+
+int netlink_init(void)
+{
+	int rc;
+
+	rc = genl_register_family(&kaux_family);
+
+	pr_info("uidfake: netlink family '%s' register rc=%d\n",
+		KAUX_FAMILY_NAME, rc);
+	return rc;
+}
+
+void netlink_exit(void)
+{
+	genl_unregister_family(&kaux_family);
+	kvfree(g_staged);
+	kvfree(g_apply);
+	g_staged = NULL;
+	g_apply = NULL;
+}
--- /dev/null
+++ b/drivers/misc/hma_uidfake/core.c
@@ -0,0 +1,330 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Native integration of HMA UIDFAKE's policy protocol and process identity.
+ * No syscall-table writes, instruction decoding, f_op substitution or TIF bits.
+ */
+#include <linux/cred.h>
+#include <linux/dcache.h>
+#include <linux/fs.h>
+#include <linux/hma_uidfake.h>
+#include <linux/init.h>
+#include <linux/kdev_t.h>
+#include <linux/mutex.h>
+#include <linux/namei.h>
+#include <linux/rcupdate.h>
+#include <linux/sched/signal.h>
+#include <linux/slab.h>
+#include <linux/sort.h>
+#include <linux/vmalloc.h>
+#include "uidfake.h"
+
+#define APP_MIN 10000u
+#define APP_SPAN 10000u
+#define USER_RANGE 100000u
+#define ISOLATED_MIN 90000u
+#define PENDING (1u << 31)
+struct uf_pair { u32 caller, target; };
+struct uf_policy { u32 n; struct uf_pair pairs[]; };
+/* Metadata references inodes by dev/ino, never replaces their operations. */
+struct uf_apk { u32 dev, uid; u64 ino; };
+struct uf_apks { u32 n; struct uf_apk entries[]; };
+static struct uf_policy __rcu *policy;
+static struct uf_apks __rcu *apks;
+static DEFINE_MUTEX(update_lock);
+static u32 apk_offered, apk_failed, apk_failed_total, apk_updates;
+
+static u32 app_id(u32 uid)
+{
+	uid %= USER_RANGE;
+	return uid >= APP_MIN && uid < APP_MIN + APP_SPAN ?
+		uid - APP_MIN + 1 : 0;
+}
+
+static int pair_cmp(const void *a, const void *b)
+{
+	const struct uf_pair *x = a, *y = b;
+	if (x->caller != y->caller)
+		return x->caller < y->caller ? -1 : 1;
+	return x->target < y->target ? -1 : x->target != y->target;
+}
+
+static bool pair_has(const struct uf_policy *p, u32 caller, u32 target)
+{
+	struct uf_pair key = { caller, target };
+	u32 lo = 0, hi = p->n;
+	while (lo < hi) {
+		u32 mid = lo + (hi - lo) / 2;
+		int cmp = pair_cmp(&p->pairs[mid], &key);
+		if (cmp < 0)
+			lo = mid + 1;
+		else if (cmp > 0)
+			hi = mid;
+		else
+			return true;
+	}
+	return false;
+}
+
+int policy_apply(const u32 *pairs, u32 n)
+{
+	struct uf_policy *next, *old;
+	u32 i, live = 0;
+	if (n > POLICY_MAX_PAIRS)
+		return -E2BIG;
+	next = kvzalloc(sizeof(*next) + n * sizeof(struct uf_pair), GFP_KERNEL);
+	if (!next)
+		return -ENOMEM;
+	for (i = 0; i < n; i++) {
+		u32 caller = pairs[2 * i], target = pairs[2 * i + 1];
+		if (target % USER_RANGE < APP_MIN)
+			continue; /* root/system targets always retain native visibility */
+		if (caller && !app_id(caller))
+			continue;
+		next->pairs[live].caller = caller ? caller % USER_RANGE : 0;
+		next->pairs[live++].target = target;
+	}
+	next->n = live;
+	sort(next->pairs, live, sizeof(struct uf_pair), pair_cmp, NULL);
+	mutex_lock(&update_lock);
+	old = rcu_dereference_protected(policy, lockdep_is_held(&update_lock));
+	rcu_assign_pointer(policy, next);
+	synchronize_rcu();
+	kvfree(old);
+	mutex_unlock(&update_lock);
+	pr_info("hma_uidfake: published %u caller/target pairs\n", live);
+	return 0;
+}
+
+/* task_struct is copied by fork; app_zygote descendants keep the original app.
+ * A system zygote child entering an isolated UID waits for its app code inode.
+ * Once named, later setuid calls cannot select another app's hiding policy.
+ */
+void hma_uidfake_creds(const struct cred *old, const struct cred *new)
+{
+	u32 before = __kuid_val(old->fsuid), after = __kuid_val(new->fsuid);
+	u32 tag, id;
+	if (before == after)
+		return;
+	tag = READ_ONCE(current->hma_uidfake_app);
+	if (tag && tag != PENDING)
+		return;
+	if (before % USER_RANGE >= APP_MIN && tag != PENDING)
+		return;
+	id = app_id(after);
+	if (id)
+		cmpxchg(&current->hma_uidfake_app, tag, id);
+	else if (after % USER_RANGE >= ISOLATED_MIN)
+		cmpxchg(&current->hma_uidfake_app, tag, PENDING);
+}
+
+bool hma_uidfake_hidden(unsigned int target)
+{
+	const struct uf_policy *p;
+	kuid_t mapped = make_kuid(current_user_ns(), target);
+	u32 tag = READ_ONCE(current->hma_uidfake_app);
+	u32 caller;
+	bool hidden = false;
+	if (!uid_valid(mapped))
+		return false;
+	target = __kuid_val(mapped);
+	if (tag == PENDING) {
+		/* Close the APK attribution window on the first UID query. */
+		cmpxchg(&current->hma_uidfake_app, PENDING, 0);
+		return false;
+	}
+	if (!tag)
+		tag = app_id(__kuid_val(current_fsuid()));
+	if (!tag)
+		return false;
+	caller = APP_MIN + tag - 1;
+	if (target % USER_RANGE == caller)
+		return false;
+	rcu_read_lock();
+	p = rcu_dereference(policy);
+	if (p)
+		hidden = pair_has(p, caller, target) || pair_has(p, 0, target);
+	rcu_read_unlock();
+	return hidden;
+}
+
+static u32 encode_dev(dev_t dev)
+{
+	return new_encode_dev(dev);
+}
+
+/* Keep all threads of an isolated process consistent; updates never sleep. */
+static void name_task(u32 id)
+{
+	struct task_struct *leader = current->group_leader, *t;
+	u32 chosen;
+	rcu_read_lock();
+	chosen = cmpxchg(&leader->hma_uidfake_app, PENDING, id);
+	if (chosen == PENDING)
+		chosen = id;
+	if (!chosen)
+		goto out; /* group leader has already closed its attribution window */
+	for_each_thread(leader, t)
+		cmpxchg(&t->hma_uidfake_app, PENDING, chosen);
+out:
+	rcu_read_unlock();
+}
+
+void hma_uidfake_open(struct file *file)
+{
+	const struct uf_apks *table;
+	struct dentry *d;
+	u32 i, depth, id = 0;
+	if (READ_ONCE(current->hma_uidfake_app) != PENDING)
+		return;
+	/* dget_parent/dput rather than racing a rename through d_parent. */
+	d = dget(file->f_path.dentry);
+	for (depth = 0; depth < 5 && d; depth++) {
+		struct inode *inode = d_inode(d);
+		struct dentry *parent;
+		if (inode) {
+			rcu_read_lock();
+			table = rcu_dereference(apks);
+			if (table)
+				for (i = 0; i < table->n; i++)
+					if (table->entries[i].ino == inode->i_ino &&
+					    table->entries[i].dev == encode_dev(inode->i_sb->s_dev)) {
+						id = app_id(table->entries[i].uid);
+						break;
+					}
+			rcu_read_unlock();
+		}
+		if (id || IS_ROOT(d)) {
+			dput(d);
+			break;
+		}
+		parent = dget_parent(d);
+		dput(d);
+		d = parent;
+	}
+	if (depth == 5 && d)
+		dput(d);
+	if (id)
+		name_task(id);
+}
+
+int uidfake_apk_apply(const u32 *blob, u32 len)
+{
+	struct uf_apks *next, *old;
+	const u8 *bytes = (const u8 *)blob;
+	u32 n, i, failed = 0;
+	int ret = 0;
+	if (len < 4)
+		return -EINVAL;
+	n = blob[0];
+	if (n > UF_APK_MAX || 4ull + 16ull * n > len)
+		return -EINVAL;
+	/* Validate the complete upload before touching the current table. */
+	for (i = 0; i < n; i++) {
+		const u32 *e = &blob[1 + 4 * i];
+		if (e[0] > 1)
+			return -EINVAL;
+		if (!e[0] && (!app_id(e[1]) || !e[3] ||
+		    e[2] < 4ull + 16ull * n || e[2] > len ||
+		    e[3] > len - e[2] || bytes[e[2] + e[3] - 1] ||
+		    strnlen((const char *)bytes + e[2], e[3]) != e[3] - 1))
+			return -EINVAL;
+	}
+	next = kvzalloc(sizeof(*next) + UF_APK_MAX * sizeof(struct uf_apk), GFP_KERNEL);
+	if (!next)
+		return -ENOMEM;
+	mutex_lock(&update_lock);
+	old = rcu_dereference_protected(apks, lockdep_is_held(&update_lock));
+	if (old) {
+		next->n = old->n;
+		memcpy(next->entries, old->entries, old->n * sizeof(struct uf_apk));
+	}
+	for (i = 0; i < n; i++) {
+		const u32 *e = &blob[1 + 4 * i];
+		struct uf_apk item;
+		u32 j;
+		if (!e[0]) {
+			struct path path;
+			struct inode *inode;
+			ret = kern_path((const char *)bytes + e[2], LOOKUP_FOLLOW, &path);
+			if (ret) { failed++; continue; }
+			inode = d_inode(path.dentry);
+			item.dev = encode_dev(inode->i_sb->s_dev);
+			item.ino = inode->i_ino;
+			item.uid = e[1];
+			path_put(&path);
+		} else {
+			item.dev = e[1];
+			item.ino = (u64)e[2] | ((u64)e[3] << 32);
+			item.uid = 0;
+		}
+		for (j = 0; j < next->n; j++)
+			if (next->entries[j].dev == item.dev && next->entries[j].ino == item.ino)
+				break;
+		if (e[0]) {
+			if (j < next->n)
+				next->entries[j] = next->entries[--next->n];
+		} else if (j < next->n) {
+			next->entries[j] = item;
+		} else if (next->n < UF_APK_MAX) {
+			next->entries[next->n++] = item;
+		} else {
+			failed++;
+		}
+	}
+	/* Failed batches preserve old table and return error so the daemon retries. */
+	if (!failed) {
+		rcu_assign_pointer(apks, next);
+		synchronize_rcu();
+		kvfree(old);
+	} else {
+		kvfree(next);
+	}
+	apk_offered = n;
+	apk_failed = failed;
+	apk_failed_total += failed;
+	apk_updates++;
+	mutex_unlock(&update_lock);
+	return failed ? -EAGAIN : 0;
+}
+
+void uidfake_status_get(struct kaux_status *out)
+{
+	const struct uf_policy *p;
+	const struct uf_apks *a;
+	memset(out, 0, sizeof(*out));
+	out->magic = KAUX_STATUS_MAGIC;
+	out->size = sizeof(*out);
+	out->version = KAUX_FAMILY_VERSION;
+	out->native = out->native_expected = 4;
+	if (IS_ENABLED(CONFIG_COMPAT))
+		out->compat = out->compat_expected = 4;
+	out->flags = KAUX_F_NATIVE | KAUX_F_SETUID;
+	if (IS_ENABLED(CONFIG_COMPAT))
+		out->flags |= KAUX_F_COMPAT;
+	out->lsm_state = KAUX_LSM_TAKEN;
+	strscpy(out->lsm_target, "native commit_creds", sizeof(out->lsm_target));
+	mutex_lock(&update_lock);
+	out->apk_offered = apk_offered;
+	out->apk_failed = apk_failed;
+	out->apk_failed_total = apk_failed_total;
+	out->apk_updates = apk_updates;
+	if (!apk_failed)
+		out->flags |= KAUX_F_APKS;
+	rcu_read_lock();
+	p = rcu_dereference(policy);
+	a = rcu_dereference(apks);
+	out->policy_pairs = p ? p->n : 0;
+	out->apk_inodes = a ? a->n : 0;
+	rcu_read_unlock();
+	mutex_unlock(&update_lock);
+}
+
+static int __init hma_uidfake_init(void)
+{
+	int ret = netlink_init();
+	if (ret)
+		pr_err("hma_uidfake: generic netlink registration failed: %d\n", ret);
+	else
+		pr_info("hma_uidfake: native built-in policy ready (protocol %u)\n", KAUX_FAMILY_VERSION);
+	return ret;
+}
+late_initcall(hma_uidfake_init);
