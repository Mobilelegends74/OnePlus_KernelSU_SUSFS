--- a/drivers/gpu/drm/drm_atomic_helper.c
+++ b/drivers/gpu/drm/drm_atomic_helper.c
@@ -25,8 +25,10 @@
  * Daniel Vetter <daniel.vetter@ffwll.ch>
  */
 
+#include <linux/bitops.h>
 #include <linux/dma-fence.h>
 #include <linux/ktime.h>
+#include <linux/string.h>
 
 #include <drm/drm_atomic.h>
 #include <drm/drm_atomic_helper.h>
@@ -573,6 +575,46 @@
 	return 0;
 }
 
+/*
+ * The OP13R vendor msm_drm module implements concurrent writeback using a
+ * virtual connector, but leaves possible_clones at its self-only default.
+ * Keep that legacy DSI/CWB topology working without relaxing clone checks
+ * for other drivers, physical outputs, or explicitly populated clone masks.
+ * The vendor atomic_check callbacks still validate the CWB resources.
+ */
+static bool drm_atomic_legacy_msm_cwb(struct drm_atomic_state *state,
+				      struct drm_crtc *crtc)
+{
+	struct drm_crtc_state *crtc_state = drm_atomic_get_new_crtc_state(state, crtc);
+	struct drm_connector *connector;
+	struct drm_connector_state *conn_state;
+	struct drm_encoder *encoder;
+	unsigned int dsi = 0, cwb = 0;
+	int i;
+
+	if (strcmp(crtc->dev->driver->name, "msm_drm") ||
+	    hweight32(crtc_state->encoder_mask) != 2)
+		return false;
+
+	drm_for_each_encoder_mask(encoder, crtc->dev, crtc_state->encoder_mask) {
+		if (encoder->possible_clones != drm_encoder_mask(encoder))
+			return false;
+	}
+
+	for_each_new_connector_in_state(state, connector, conn_state, i) {
+		if (conn_state->crtc != crtc)
+			continue;
+		if (connector->connector_type == DRM_MODE_CONNECTOR_DSI)
+			dsi++;
+		else if (connector->connector_type == DRM_MODE_CONNECTOR_VIRTUAL)
+			cwb++;
+		else
+			return false;
+	}
+
+	return dsi == 1 && cwb == 1;
+}
+
 static int drm_atomic_check_valid_clones(struct drm_atomic_state *state,
 					 struct drm_crtc *crtc)
 {
@@ -580,6 +622,11 @@
 	struct drm_crtc_state *crtc_state = drm_atomic_get_new_crtc_state(state,
 									  crtc);
 
+	if (drm_atomic_legacy_msm_cwb(state, crtc)) {
+		pr_info_once("OP13R DRM: legacy DSI/CWB clone compatibility enabled\n");
+		return 0;
+	}
+
 	drm_for_each_encoder_mask(drm_enc, crtc->dev, crtc_state->encoder_mask) {
 		if (!drm_enc->possible_clones) {
 			DRM_DEBUG("enc%d possible_clones is 0\n", drm_enc->base.id);
@@ -590,6 +637,10 @@
 		    crtc_state->encoder_mask) {
 			DRM_DEBUG("crtc%d failed valid clone check for mask 0x%x\n",
 				  crtc->base.id, crtc_state->encoder_mask);
+			if (!strcmp(crtc->dev->driver->name, "msm_drm"))
+				pr_warn_ratelimited("OP13R DRM: clone check rejected crtc%d mask=0x%x enc%d clones=0x%x\n",
+					crtc->base.id, crtc_state->encoder_mask,
+					drm_enc->base.id, drm_enc->possible_clones);
 			return -EINVAL;
 		}
 	}
